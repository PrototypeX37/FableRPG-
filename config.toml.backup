[[gods]]
name = "Astraea"
user = 635319019083137057
description = "**Alignment: Good** - Astraea is a goddess of kindness and healing. Her devotees pray for her blessings to bring comfort, aid, and positive outcomes to those in need. She embodies benevolence and strives to alleviate suffering in the world"
boundary_low = 0.9
boundary_high = 1.1

[[gods]]
name = "Sepulchure"
user = 384534935068737536
description = "**Alignment: Evil** - Sepulchure is a malevolent deity associated with darkness and destruction. His followers seek his favor to sow chaos, spread fear, and bring about ruin. Sepulchure revels in the suffering of others and encourages acts of malevolence."
boundary_low = 0.75
boundary_high = 1.5

[[gods]]
name = "Drakath"
user = 700801066593419335
description = "**Alignment: Chaos** - Drakath, the chaotic deity, embodies the thrill of unpredictability and upheaval. Followers celebrate the untamed essence of existence, finding liberation in disrupting norms and embracing disorder. In Drakath's realm, change is revered, and the uncharted path is the most revered journey."
boundary_low = 0.3
boundary_high = 2.0
