global_prefix = "$"
owner_id = 0
is_beta = true
is_custom = false
global_cooldown = 3
donator_cooldown = 2

[external]
patreon_token = "my secret patreon token" 
imgur_token = "We dont need this"
openai = "Your OpenAI Key"
okapi_token = "my secret okapi token"
traviapi = "just a secret"
base_url = "Your Baseurl if any"
okapi_url = "http://127.0.0.1:3000" 
proxy_url = "http://my.proxy" #not required
proxy_auth = "proxy-auth-key" # not required

[[external.donator_roles]]
id = 1234
tier = "basic"

[database]
postgres_name = "Fable"
postgres_user = "postgres"
